VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Opcional: fotos de ejercicios en Cloudinary (upload "unsigned" desde el navegador).
# Si falta alguna, las fotos se guardan en Supabase Storage.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Solo para el servidor (función api/delete-image.js): borrar la foto al reemplazarla o
# borrar el ejercicio. Nunca llegan al navegador. Sin estas, la foto queda en Cloudinary.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
